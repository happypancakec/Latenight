  emails:
  - id: day1_seven_day_property_Inspection
    sender: Sliver Pines Property Company
    subject: Seven-day Property Inspection
    message: 'Hello Maya,



      We are contacting you regarding the trailer park
      inherited from your late grandmother.



      Under the terms of the will,
      you must maintain the property for seven days before deciding whether to keep
      it or accept our purchase offer.



      We will contact you again at the
      end of the week.



      Silver Pines Property Company'
    availableFromDay: 1
    addsTask: 0
    taskId: 
    taskDescription: 
  - id: day2_broken_fence
    sender: June - Lot 3
    subject: Broken fence
    message: 'Hello Maya,


      the fence near my lot is broken can you fix it '
    availableFromDay: 2
    addsTask: 1
    taskId: fix_broken_fence
    taskDescription: Fix the broken fence near Lot 3.
